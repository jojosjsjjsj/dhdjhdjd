local function bleed_out(vhum)
	if bleeding[vhum] then return end
	bleeding[vhum] = true

	local hrp = vhum.RootPart
	if not hrp then return end

	-- immobilize
	vhum.WalkSpeed = 0
	vhum.JumpPower = 0
	vhum.AutoRotate = false

	-- impact sound
	local s1 = Instance.new("Sound", hrp)
	s1.SoundId = "rbxassetid://4620904701"
	s1.Volume = 1
	s1:Play()

	-- blood
	local blood = assets.Effects.Blood.Blood:Clone()
	blood.Parent = hrp

	-- bleed spam
	task.spawn(function()
		while vhum.Health > 0 do
			for _, p in ipairs(blood:GetChildren()) do
				p:Emit(30)
			end
			task.wait(0.12)
            vhum.Health -= 5
		end
	end)

	-- delayed sound
	task.delay(4, function()
		if vhum.Health > 0 then
			local s2 = Instance.new("Sound", hrp)
			s2.SoundId = "rbxassetid://613960902"
			s2.Volume = 1
			s2:Play()
			Debris:AddItem(s2, 6)
		end
	end)

	-- cleanup
	vhum.Died:Once(function()
		s1:Destroy()
		blood:Destroy()
	end)
end

