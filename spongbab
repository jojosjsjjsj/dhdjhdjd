local function play(what, p, scf)
	if sounds[what] then
		local snd = sounds[what]:Clone()
		snd.Name = what
		snd.Parent = p or hum.RootPart

		local pt

		if scf ~= nil then
			pt = Instance.new("Part", soundstorage)
			pt.CFrame = scf
			pt.CanCollide = false
			pt.CanQuery = false
			pt.CanTouch = false
			pt.Anchored = true
			pt.Transparency = 1
			pt.Size = Vector3.one

			snd.Parent = pt
		end

		snd:Play()

		snd.Ended:Once(function()
			task.wait(.1)

			snd:Destroy()

			if pt then
				pt:Destroy()
			end
		end)

		return snd
	end
end

