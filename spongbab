	snd:Play()

	hum.WalkSpeed = 90

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {char}

	local elapsed = 0
	local con

	con = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 4 then
			con:Disconnect()
			return
		end

		local parts = workspace:GetPartBoundsInRadius(
			hum.RootPart.Position,
			6,
			params
		)

		for _, part in ipairs(parts) do
			local mdl = part:FindFirstAncestorOfClass("Model")
			if mdl then
				local vhum = mdl:FindFirstChildOfClass("Humanoid")
				if vhum and vhum ~= hum and vhum.Health > 0 then
					bleed_out(vhum)
				end
			end
		end
	end)

	task.delay(4, function()
		hum.WalkSpeed = 45
		snd:Destroy()
		task.delay(8, function()
			e_cd = false
		end)
	end)
end

